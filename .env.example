APP_NAME="BikriBook"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bikribook
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_HOST=127.0.0.1

# ---- Billing (SaaS subscriptions) ----
CASHIER_CURRENCY=inr
STRIPE_KEY=
STRIPE_SECRET=
RAZORPAY_KEY=
RAZORPAY_SECRET=

# ---- Invoicing mode ----
# Tenants choose 'gst' or 'non_gst' in Settings; this is only the seed default.
DEFAULT_TAX_MODE=gst

# ---- GST / e-Invoice (NIC IRP, direct or via GSP) ----
EINVOICE_DRIVER=sandbox           # sandbox = offline fake | nic = live IRP
EINVOICE_SANDBOX_URL=https://einv-apisandbox.nic.in
EINVOICE_PRODUCTION_URL=https://api.einvoice1.gst.gov.in
EINVOICE_BASE_URL=https://einv-apisandbox.nic.in
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=
EWAYBILL_BASE_URL=https://ewaybillgst.gov.in
GSTIN_VERIFY_URL=

# ---- Shopify app ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_SCOPES="read_orders,read_products,read_customers,read_fulfillments,write_draft_orders"
SHOPIFY_WEBHOOK_SECRET=
