# BikriBook — project-root .htaccess
#
# WHEN THIS FILE IS USED
# Your hosting document root is the PROJECT folder (public_html contains
# app/, config/, public/, vendor/, …). This file serves the app from public/
# with an INTERNAL rewrite, so the site opens at https://example.com/
# and URLs never contain /public.
#
# It never issues a redirect, so it cannot cause ERR_TOO_MANY_REDIRECTS.
#
# PREFERRED SETUP: point the domain's document root at <project>/public — then
# this file is outside the web root and the blocks below are belt-and-braces.
# Steps are in DEPLOY.md.

# ---------------------------------------------------------------------------
# 1. Front controller: serve everything from public/ without changing the URL.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Requests that already target /public are served as-is.
    # This guard is what prevents redirect loops on the /public path.
    RewriteCond %{REQUEST_URI} !^/public/

    # Everything else is served from public/ WITHOUT changing the browser URL.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ---------------------------------------------------------------------------
# 2. Never serve these file types, whatever they are called.
#
# <FilesMatch> is core Apache, so this works even when mod_alias (which
# RedirectMatch needs) is disabled — the most common reason a "blocked" .env
# is still downloadable on shared hosting.
# ---------------------------------------------------------------------------
<FilesMatch "(?i)^\.env|\.(env\..*|zip|tar|gz|tgz|bz2|7z|rar|sql|sqlite|sqlite3|db|bak|backup|old|orig|save|swp|log|ini|conf|cfg|yml|yaml|sh|bash|pem|key|crt|cer|p12|pfx|jks|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Dotfiles (except the well-known ACME challenge used by Let's Encrypt).
<FilesMatch "^\.(?!well-known)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# 3. Application internals must never be reachable (mod_alias, best effort).
# ---------------------------------------------------------------------------
<IfModule mod_alias.c>
    # Source code, config, database dumps, storage, tests, vendor
    RedirectMatch 404 ^/(app|bootstrap|config|database|lang|resources|routes|tests|vendor)(/|$)

    # Private storage (logs, framework cache, app files) — public files are
    # reached through public/storage instead.
    RedirectMatch 404 ^/storage/(app|framework|logs)(/|$)

    # CLI tooling, dependency manifests and project documentation
    RedirectMatch 404 ^/(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|.*\.md)$
</IfModule>

# ---------------------------------------------------------------------------
# 4. Directory listings off.
# ---------------------------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------------------------
# 5. Baseline response headers.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # The service worker must never be cached, or clients keep an old version.
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
