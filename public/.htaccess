<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Never serve these file types.
#
# The project should sit outside the web root (public/ is the document root),
# but if the folder above this one is ever exposed — or a file is dropped in
# here by mistake — these must not be downloadable. Core Apache, so it works
# without mod_alias.
# ---------------------------------------------------------------------------
<FilesMatch "(?i)^\.env|\.(env\..*|zip|tar|gz|tgz|bz2|7z|rar|sql|sqlite|sqlite3|db|bak|backup|old|orig|save|swp|log|ini|conf|cfg|yml|yaml|sh|bash|pem|key|crt|cer|p12|pfx|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# The service worker must always be revalidated so clients pick up fixes.
<IfModule mod_headers.c>
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
